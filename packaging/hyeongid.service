[Unit]
# hyeongid — the HYEONGI daemon: IDS bridge (Snort 3 / Suricata alerts),
# ML flow detector (when a model exists), block expiry and hourly read-only
# LLM triage, in one process.
# Settings: /etc/hyeongi/hyeongi.yaml  (enforce: false = dry-run, blocks nothing)
# Logs:     journalctl -u hyeongid
Description=HYEONGI daemon (detection -> blocklist -> kernel enforcement)
After=network-online.target hyeongi-xdp.service hyeongi-ids.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__ROOT__
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m hyeongi.daemon
Restart=on-failure
RestartSec=5
# exit status 2 = misconfiguration (e.g. XDP backend not loaded): don't loop
RestartPreventExitStatus=2
Nice=5
# the daemon exits within a few seconds on stop; never wait the default 90 s
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
