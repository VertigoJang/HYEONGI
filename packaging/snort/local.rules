# HYEONGI local Snort 3 rules — loaded by /etc/hyeongi/snort/hyeongi.lua
# (installed to /etc/hyeongi/snort/local.rules; edit there, then:
#  sudo systemctl restart hyeongi-ids)
#
# Port scans are detected by Snort's built-in port_scan inspector (gid 122),
# enabled in hyeongi.lua — no rule needed here.

# Inbound connection attempts to services a laptop should never expose.
alert tcp any any -> any 23   (msg:"HYEONGI inbound telnet attempt"; flags:S; sid:1100001; rev:1;)
alert tcp any any -> any 445  (msg:"HYEONGI inbound SMB attempt"; flags:S; sid:1100002; rev:1;)
alert tcp any any -> any 3389 (msg:"HYEONGI inbound RDP attempt"; flags:S; sid:1100003; rev:1;)
alert tcp any any -> any 5900 (msg:"HYEONGI inbound VNC attempt"; flags:S; sid:1100004; rev:1;)

# Floods and brute force: many new connections from one source in a short time.
alert tcp any any -> any any (msg:"HYEONGI possible SYN flood"; flags:S; detection_filter:track by_src, count 1500, seconds 2; sid:1100010; rev:2;)
alert tcp any any -> any 22  (msg:"HYEONGI SSH brute force (many new connections)"; flags:S; detection_filter:track by_src, count 10, seconds 30; sid:1100011; rev:1;)

# Pipeline self-test: uncomment, restart hyeongi-ids, ping this machine from
# another host, and watch `hyeongi logs`. Comment it out again afterwards.
# alert icmp any any -> any any (msg:"HYEONGI TEST ICMP"; itype:8; sid:1199999; rev:1;)
