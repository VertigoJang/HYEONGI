#!/usr/bin/env bash
# hyeongi — AI firewall front-end (detection → blocklist → kernel enforcement)
#
# Prints the HYEONGI banner, then either shows the menu (no args) or
# dispatches a subcommand to the underlying hyeongi/benchmark modules.
# Pure wrapper: it does not change behaviour, it just gives the project a
# single branded entrypoint (the commands you already run still work directly).

set -euo pipefail

# --- locate the repo root (this script lives in <repo>/bin; it may be called
#     through the /usr/local/bin/hyeongi symlink) -------------------------------
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"

# --- colours (disabled when stdout is not a TTY or NO_COLOR is set) -----------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\e[1m'; DIM=$'\e[2m'; RST=$'\e[0m'
  RED=$'\e[38;5;196m'; CRIMSON=$'\e[38;5;160m'; WHITE=$'\e[38;5;231m'
  CYAN=$'\e[38;5;44m'; GREY=$'\e[38;5;244m'
else
  BOLD=""; DIM=""; RST=""; RED=""; CRIMSON=""; WHITE=""; CYAN=""; GREY=""
fi

VERSION="$(sed -n 's/^__version__ *= *"\(.*\)"/\1/p' hyeongi/__init__.py 2>/dev/null || echo '?')"

banner() {
  printf '%s\n' ""
  printf ' %s%s%s\n' "$WHITE" '██╗  ██╗██╗   ██╗███████╗ ██████╗ ███╗   ██╗ ██████╗ ██╗' "$RST"
  printf ' %s%s%s\n' "$WHITE" '██║  ██║╚██╗ ██╔╝██╔════╝██╔═══██╗████╗  ██║██╔════╝ ██║' "$RST"
  printf ' %s%s%s\n' "$WHITE" '███████║ ╚████╔╝ █████╗  ██║   ██║██╔██╗ ██║██║  ███╗██║' "$RST"
  printf ' %s%s%s\n' "$WHITE" '██╔══██║  ╚██╔╝  ██╔══╝  ██║   ██║██║╚██╗██║██║   ██║██║' "$RST"
  printf ' %s%s%s\n' "$WHITE" '██║  ██║   ██║   ███████╗╚██████╔╝██║ ╚████║╚██████╔╝██║' "$RST"
  printf ' %s%s%s\n' "$WHITE" '╚═╝  ╚═╝   ╚═╝   ╚══════╝ ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚═╝' "$RST"
  printf ' %s%s%s\n' "$RED" 'Host-based, Your-network-gated Enforcement' "$RST"
  printf ' %s%s%s\n' "$RED" 'with On-device Network Guard & Inspection' "$RST"
  printf '\n'
  # version on the left, author + GitHub link right-aligned to the logo width (57 columns)
  local left="   v$VERSION" right_txt="by VertigoJang · github.com/VertigoJang"
  local url="https://github.com/VertigoJang" link="github.com/VertigoJang"
  if [[ -t 1 ]]; then link=$'\e]8;;'"$url"$'\e\\'"github.com/VertigoJang"$'\e]8;;\e\\'; fi
  local pad=$(( 57 - ${#left} - ${#right_txt} )); (( pad < 2 )) && pad=2
  printf '%s%s%s%*s%sby VertigoJang · %s%s\n\n' "$GREY" "$left" "$RST" "$pad" "" "$DIM" "$link" "$RST"
}

menu() {
  banner
  cat <<EOF
  ${BOLD}USAGE${RST}
    ${CYAN}hyeongi${RST} <command> [options]

  ${BOLD}ENFORCEMENT${RST}  (shared kernel blocklist — nftables or XDP)
    ${CYAN}status${RST}            show the live blocklist (configured backend)
    ${CYAN}block${RST} <ip>        add an IP to the blocklist        ${DIM}(root)${RST}
    ${CYAN}unblock${RST} <ip>      remove an IP                      ${DIM}(root)${RST}
    ${CYAN}setup${RST} / ${CYAN}teardown${RST}  create / remove the nft table    ${DIM}(root)${RST}
    ${CYAN}xdp${RST}               XDP backend status (blocked IPs, drops) ${DIM}(root)${RST}

  ${BOLD}DETECTION${RST}
    ${CYAN}watch${RST}             IDS bridge in the foreground       ${DIM}(hyeongi.snort_bridge)${RST}
    ${CYAN}detect${RST}            ML detector in the foreground      ${DIM}(hyeongi.ml_detector, root)${RST}
    ${CYAN}triage${RST}            LLM triage report (read-only)      ${DIM}(hyeongi.triage)${RST}
    ${DIM}(hyeongid runs all of these in the background)${RST}

  ${BOLD}MODEL / BENCHMARK${RST}
    ${CYAN}train${RST}             train the ML detector              ${DIM}(ml.train)${RST}
    ${CYAN}eval${RST}              measure FPR + pick a threshold     ${DIM}(ml.eval)${RST}
    ${CYAN}bench${RST}             run the enforcement benchmark      ${DIM}(benchmark/)${RST}
    ${CYAN}tune${RST}              fit the LLM model + flow-log size to this machine ${DIM}(--apply: root)${RST}

  ${BOLD}SERVICES${RST}  (systemd; settings in /etc/hyeongi/hyeongi.yaml)
    ${CYAN}start${RST} / ${CYAN}stop${RST}       turn every HYEONGI service on / off ${DIM}(root)${RST}
    ${CYAN}net${RST}               current network + whether it enforces
    ${CYAN}trust-here${RST}        enforce on THIS network, observe elsewhere ${DIM}(root)${RST}
    ${CYAN}name-here${RST} NAME    name THIS network in the training data   ${DIM}(root)${RST}
    ${CYAN}services${RST}          status of hyeongid and the other units
    ${CYAN}config${RST}            print the effective config
    ${CYAN}logs${RST}              follow hyeongid and IDS logs (Ctrl+C to quit)
    ${CYAN}report${RST}            run LLM triage now and show the report ${DIM}(root)${RST}
    ${CYAN}pause${RST} / ${CYAN}resume${RST}    stop / restart training-data collection ${DIM}(attack practice; root)${RST}
    ${CYAN}practice${RST} start|end  stop HYEONGI fully for practice, then restart + check ${DIM}(root)${RST}
    ${CYAN}stats${RST}             collection and detection summary
    ${CYAN}gui${RST}               open the desktop app
    ${CYAN}demo${RST} on IFACE|off  presentation mode on an isolated lab interface ${DIM}(root)${RST}

    ${CYAN}version${RST} | ${CYAN}help${RST}
  ${DIM}Detectors default to --dry-run. Enforcement is never automatic.${RST}

EOF
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    printf '%s!%s this command touches the kernel blocklist and needs root — re-run with %ssudo%s\n' \
           "$RED" "$RST" "$BOLD" "$RST" >&2
  fi
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift || true
case "$cmd" in
  ""|help|-h|--help)        menu ;;
  version|-v|--version)     banner ;;
  xdp)                      need_root; exec python3 -m hyeongi.xdp "${@:-status}" ;;
  status|list)              exec python3 -m hyeongi.blocklist list "$@" ;;
  block|add)                need_root; exec python3 -m hyeongi.blocklist add "$@" ;;
  unblock|remove|del)       need_root; exec python3 -m hyeongi.blocklist remove "$@" ;;
  flush)                    need_root; exec python3 -m hyeongi.blocklist flush "$@" ;;
  setup)                    need_root; exec python3 -m hyeongi.blocklist setup "$@" ;;
  teardown)                 need_root; exec python3 -m hyeongi.blocklist teardown "$@" ;;
  watch|snort)              exec python3 -m hyeongi.snort_bridge "$@" ;;
  detect|ml)                need_root; exec python3 -m hyeongi.ml_detector "$@" ;;
  triage|llm)               exec python3 -m hyeongi.triage "$@" ;;
  train)                    exec python3 -m ml.train "$@" ;;
  eval)                     exec python3 -m ml.eval "$@" ;;
  services|svc)
    for u in hyeongid hyeongi-ids hyeongi-xdp hyeongi-capture; do
      printf '  %-22s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null || true)"
    done
    printf '  %-22s %s\n' "enforce" "$(python3 -m hyeongi.service show 2>/dev/null | sed -n 's/^enforce: //p')"
    printf '  %-22s %s\n' "backend" "$(python3 -m hyeongi.service show 2>/dev/null | sed -n 's/^backend: //p')"
    python3 -m hyeongi.ctl net 2>/dev/null | sed 's/^/  /'
    ;;
  config)                   exec python3 -m hyeongi.service show "$@" ;;
  logs)                     exec journalctl -fu hyeongid -u hyeongi-ids ;;
  report)
    need_root
    python3 -m hyeongi.service triage && \
      cat "$(python3 -m hyeongi.service show | sed -n '/^triage:/,/^[^ ]/s/^  out: //p')" ;;
  bench|benchmark)          exec bash benchmark/run_bench.sh "$@" ;;
  tune)                     exec python3 -m hyeongi.tune "$@" ;;
  pause|resume)             need_root; exec python3 -m hyeongi.collect "$cmd" "$@" ;;
  practice)                 need_root; exec python3 -m hyeongi.ctl practice "$@" ;;
  stats)                    exec python3 -m hyeongi.status "$@" ;;
  gui|app)                  exec python3 -m hyeongi.gui "$@" ;;
  ctl)                      exec python3 -m hyeongi.ctl "$@" ;;
  net)                      exec python3 -m hyeongi.ctl net "$@" ;;
  trust-here)               need_root; exec python3 -m hyeongi.ctl trust-here "$@" ;;
  untrust-here)             need_root; exec python3 -m hyeongi.ctl untrust-here "$@" ;;
  name-here)                need_root; exec python3 -m hyeongi.ctl name-here "$@" ;;
  unname-here)              need_root; exec python3 -m hyeongi.ctl unname-here "$@" ;;
  start)                    need_root; exec python3 -m hyeongi.ctl start "$@" ;;
  stop)                     need_root; exec python3 -m hyeongi.ctl stop "$@" ;;
  restart)                  need_root; exec python3 -m hyeongi.ctl restart "$@" ;;
  demo)                     need_root; exec python3 -m hyeongi.demo "$@" ;;
  *)
    printf '%sunknown command:%s %s\n\n' "$RED" "$RST" "$cmd" >&2
    menu >&2
    exit 2 ;;
esac
